# Deep Internet Research: your own API keys.
# Paste each key after the = sign, no quotes, no spaces. Save the file.
# This file is never shared. Do not paste keys into the chat.

# Firecrawl: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Brave Search API: https://api-dashboard.search.brave.com/app/keys
BRAVE_API_KEY=

# Exa: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Tavily: https://app.tavily.com (the key is on your dashboard home)
TAVILY_API_KEY=

# Apify (powers the Reddit search): https://console.apify.com/settings/integrations
APIFY_TOKEN=
